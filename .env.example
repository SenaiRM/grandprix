# Banco de dados PostgreSQL (Railway injeta automaticamente)
DATABASE_URL="postgresql://usuario:senha@host:5432/grandprix?schema=public"

# Senha do painel admin
ADMIN_PASSWORD="senai2026"

# Chave secreta para JWT (gere uma string aleatória de 64 chars)
JWT_SECRET="substitua-por-string-aleatoria-64-caracteres"

# URL pública do app (usada nos redirects)
NEXT_PUBLIC_APP_URL="https://seu-app.railway.app"

# Cloudinary (obtido em cloudinary.com → Dashboard)
CLOUDINARY_CLOUD_NAME="seu-cloud-name"
CLOUDINARY_API_KEY="sua-api-key"
CLOUDINARY_API_SECRET="seu-api-secret"
